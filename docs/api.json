    "/api/admin/users": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Semua user",
        "description": "Monitoring user beserta total artikel.",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/UserStatsEnvelope"
            }
          },
          "401": {
            "description": "Token tidak ada / tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "Bukan admin",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/admin/posts": {
