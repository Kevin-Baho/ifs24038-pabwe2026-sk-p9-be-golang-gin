            "description": "Permintaan tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Token tidak ada / tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "ID"
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Posts"
        ],
        "summary": "Update artikel",
        "description": "Mengubah artikel milik penulis (parsial).",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/PostEnvelope"
            }
          },
          "400": {
            "description": "Permintaan tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Token tidak ada / tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "ID"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdatePostRequest"
            }
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Posts"
        ],
        "summary": "Hapus artikel",
        "description": "Menghapus artikel milik penulis.",
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "400": {
            "description": "Permintaan tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Token tidak ada / tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "ID"
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/posts/{id}/toggle-publish": {
      "patch": {
        "tags": [
          "Posts"
        ],
        "summary": "Toggle terbit/draf",
        "description": "Mengubah status draf <-> terbit dan mengatur published_at.",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/PostEnvelope"
            }
          },
          "400": {
            "description": "Permintaan tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
