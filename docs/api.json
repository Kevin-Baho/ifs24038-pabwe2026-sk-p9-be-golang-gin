{
  "swagger": "2.0",
  "info": {
    "title": "Delcom Blog REST API",
    "description": "Dokumentasi RESTful API Backend Delcom Blog Multi-Tier & AI Generator dengan Integrasi Search Engine (Golang Gin, Feature-First & TDD).",
    "version": "1.0.0",
    "contact": {
      "name": "Delcom - Labs"
    }
  },
  "host": "",
  "basePath": "/",
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Format token: Bearer <token_jwt>"
    }
  },
  "paths": {
    "/swagger/{any}": {
      "get": {
        "tags": [
          "Docs"
        ],
        "summary": "Swagger UI",
        "description": "Antarmuka Swagger UI interaktif.",
        "responses": {
          "200": {
            "description": "HTML Swagger UI"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "any",
            "type": "string",
            "required": true,
            "description": "index.html, dll."
          }
        ]
      }
    },
    "/api.json": {
      "get": {
        "tags": [
          "Docs"
        ],
        "summary": "OpenAPI JSON dinamis",
        "description": "Spesifikasi OpenAPI dengan host & scheme mengikuti URL request.",
        "responses": {
          "200": {
            "description": "Dokumen OpenAPI 2.0"
          }
        }
      }
    },
    "/api/public/categories": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Daftar kategori",
        "description": "Kategori artikel yang tersedia.",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CategoriesEnvelope"
            }
          }
        }
      }
    },
    "/api/public/posts": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Artikel terbit",
        "description": "Artikel publik yang sudah terbit.",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/PostListEnvelope"
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "type": "string",
            "description": "Kata kunci (judul, ringkasan, isi)"
          },
          {
            "in": "query",
            "name": "category",
            "type": "string",
            "description": "Filter kategori"
          }
        ]
      }
    },
    "/api/public/posts/{slug}": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Detail artikel terbit",
        "description": "Detail artikel terbit berdasarkan slug, termasuk data penulis dan reading_time.",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/PostEnvelope"
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "type": "string",
            "required": true,
            "description": "Slug artikel"
          }
        ]
      }
    },
