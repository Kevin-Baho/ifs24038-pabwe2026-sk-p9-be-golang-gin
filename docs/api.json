        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/posts/ai-generate": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "AI Blog Generator",
        "description": "Menghasilkan artikel. Jika `include_web_search` true, memanggil search engine dan menyertakan sitasi.",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/GenerateEnvelope"
            }
          },
          "400": {
            "description": "Permintaan tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Token tidak ada / tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Gagal memanggil OpenAI",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GeneratePostRequest"
            }
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/posts/{id}": {
      "get": {
        "tags": [
          "Posts"
        ],
        "summary": "Detail artikel saya",
