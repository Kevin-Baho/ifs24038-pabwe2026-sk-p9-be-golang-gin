  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "fail"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "RegisterRequest": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "password": {
          "type": "string",
          "minLength": 6,
          "maxLength": 72
        }
      },
      "required": [
        "username",
        "email",
        "password"
      ]
    },
    "LoginRequest": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Username atau email"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "username",
        "password"
      ]
    },
    "UpdateProfileRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "password": {
          "type": "string",
          "minLength": 6,
          "maxLength": 72
        }
      }
    },
    "UserResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "admin",
            "member"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "AuthResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "user": {
          "$ref": "#/definitions/UserResponse"
        }
      }
    },
    "CreatePostRequest": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": [
            "Teknologi",
            "Pendidikan",
            "Gaya Hidup",
            "Bisnis",
            "Opini",
            "Umum"
          ]
        },
        "excerpt": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "description": "Markdown"
        },
        "cover_image_path": {
          "type": "string"
        },
        "is_published": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "content"
      ]
    },
    "UpdatePostRequest": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "Teknologi",
            "Pendidikan",
            "Gaya Hidup",
            "Bisnis",
            "Opini",
            "Umum"
          ]
        },
        "excerpt": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "cover_image_path": {
          "type": "string",
          "description": "Isi \"DELETE\" atau \"remove\" untuk menghapus cover"
        },
        "is_published": {
          "type": "boolean"
        }
      }
    },
    "AuthorResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        }
      }
    },
    "PostResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "user_id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "cover_image_path": {
          "type": "string"
        },
        "is_published": {
          "type": "boolean"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "reading_time": {
          "type": "integer",
          "description": "Menit baca = total kata / 200 wpm (min 1)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "$ref": "#/definitions/AuthorResponse"
        }
      }
    },
    "StatsResponse": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "total_terbit": {
          "type": "integer"
        },
        "draft": {
          "type": "integer"
        }
      }
    },
    "UserWithStats": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
