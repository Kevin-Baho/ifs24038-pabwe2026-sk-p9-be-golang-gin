              "$ref": "#/definitions/PostListEnvelope"
            }
          },
          "401": {
            "description": "Token tidak ada / tidak valid",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Posts"
        ],
        "summary": "Buat artikel",
        "description": "Membuat artikel dengan slug unik otomatis dan reading_time.",
        "responses": {
          "201": {
            "description": "Dibuat",
            "schema": {
              "$ref": "#/definitions/PostEnvelope2"
            }
          },
          "400": {
            "description": "Permintaan tidak valid",
